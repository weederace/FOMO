DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fomo
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# crawl (default, no key), mock, or fomoapi (needs FOMO_API_KEY)
DATA_PROVIDER=crawl
MOCK_MODE=false

# Public page crawl. Leave BROWSER_EXECUTABLE_PATH empty to use the Chromium that
# `playwright install chromium` provides.
CRAWL_URL=https://fomoapi.io/
CRAWL_LEADERBOARD_WINDOW=24h
CRAWL_LEADERBOARD_LIMIT=100
CRAWL_ALERT_LIMIT=25
CRAWL_CACHE_SECONDS=10
CRAWL_RENDER_TIMEOUT_SECONDS=45
CRAWL_RESPECT_ROBOTS=true
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=true

# Optional direct-API mode, used only when DATA_PROVIDER=fomoapi
FOMO_BASE_URL=https://fomo.family/
FOMO_API_BASE_URL=https://api.fomoapi.io
FOMO_API_KEY=

# On-chain explorer API keys. Etherscan V2 covers Ethereum, Base, and BSC.
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
CRYPTOAPIS_API_KEY=
COINGECKO_API_KEY=

# Optional on-chain wallet scanning. Leave URLs empty to disable a network.
CHAIN_SCAN_ENABLED=false
ETH_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
SOLANA_RPC_URL=
CHAIN_SCAN_LOOKBACK_BLOCKS=2000
CHAIN_SCAN_WALLET_LIMIT=50
CHAIN_SCAN_INTERVAL_SECONDS=60
ETH_DAILY_REQUEST_LIMIT=100000
EVM_REQUESTS_PER_SECOND=5
SOLANA_MONTHLY_REQUEST_LIMIT=10000000
SOLANA_REQUESTS_PER_SECOND=1000

# Optional GMGN integration (wallet intelligence + market radar) through the
# gmgn-cli tool. It installs itself on first use; get a free API key at
# https://gmgn.ai/ai. Nothing runs while GMGN_ENABLED=false.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_CLI_COMMAND=gmgn-cli
GMGN_REQUEST_TIMEOUT_SECONDS=60
GMGN_ENRICH_INTERVAL_SECONDS=300
GMGN_MARKET_INTERVAL_SECONDS=60
GMGN_MARKET_CACHE_SECONDS=60
GMGN_WALLET_LIMIT=50
GMGN_WALLET_BATCH_SIZE=10
GMGN_ACTIVITY_LIMIT=50
GMGN_HOLDINGS_LIMIT=50
GMGN_MARKET_ROW_LIMIT=30
GMGN_DEFAULT_CHAIN=sol

COLLECTION_INTERVAL_SECONDS=300
LEADERBOARD_INTERVAL_SECONDS=10
TRADER_REFRESH_INTERVAL_SECONDS=900
TRADE_REFRESH_INTERVAL_SECONDS=900
SCORE_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=3600
MAX_CONCURRENT_PROVIDER_REQUESTS=8
DETAIL_COLLECTION_LIMIT=50
LOG_LEVEL=INFO

# Whale Flow feed: show only whale trades of at least this USD size (24h window).
FLOW_MIN_USD=100
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_SECOND=1
WATCHLIST_SCORE_THRESHOLD=75
WATCHLIST_CONFIDENCE_THRESHOLD=70
MIN_HISTORY_POINTS=3
EMERGING_MIN_SCORE=60
EMERGING_MIN_CONFIDENCE=60
EMERGING_MIN_SCORE_GROWTH=10
EMERGING_LOOKBACK_DAYS=7
EMERGING_MIN_HISTORY=3
